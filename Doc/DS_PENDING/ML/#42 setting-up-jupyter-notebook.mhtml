nstall sklearn</span></span><br><span><span class=3D"mtk1">pip install matp=
lotlib</span></span><br><span><span class=3D"mtk1">pip install seaborn</spa=
n></span><br><span><span class=3D"mtk1">pip install nltk</span></span><br><=
span><span class=3D"mtk1">pip install beautifulsoup4</span></span><br><span=
><span></span></span><br></div></code></pre></pre>
